# Chrome DevTools Protocol endpoint (host only, no port)
CDP_HOST=192.168.1.100

# Chrome DevTools Protocol endpoint (port only)
CDP_PORT=9222

# HTTP API server bind address (use 0.0.0.0 to expose on all interfaces)
API_HOST=0.0.0.0

# HTTP API server port
API_PORT=8080

# Comma-separated domains for CLI mode (e.g. youtube.com,google.com).
# Leave empty to run in API mode.
CLI_DOMAINS=
